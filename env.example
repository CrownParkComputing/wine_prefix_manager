# IGDB (Twitch) API Credentials
# Get these from: https://dev.twitch.tv/console/apps
IGDB_CLIENT_ID=your_client_id_here
IGDB_CLIENT_SECRET=your_client_secret_here

# Optional: Override default API URLs (usually not needed)
# TWITCH_OAUTH_URL=https://id.twitch.tv/oauth2/token
# IGDB_API_BASE_URL=https://api.igdb.com/v4
# IGDB_IMAGE_BASE_URL=https://images.igdb.com/igdb/image/upload 